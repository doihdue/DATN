            <staticText>
                <reportElement style="TableHeader" x="265" y="0" width="60" height="20" uuid="a1a1a1a1-0066-0000-0000-000000000066"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Số lượng]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="330" y="0" width="200" height="20" uuid="a1a1a1a1-0067-0000-0000-000000000067"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Cách dùng & Liều lượng chi tiết]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band: Each prescribed medicine -->
    <detail>
        <band height="28" splitType="Stretch">
            <printWhenExpression><![CDATA[$P{hasPrescription}]]></printWhenExpression>
            <rectangle>
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="0" width="535" height="28" backcolor="#FFFFFF" uuid="a1a1a1a1-0068-0000-0000-000000000068"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E5E7EB"/>
                </graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Default" x="0" y="4" width="30" height="20" uuid="a1a1a1a1-0069-0000-0000-000000000069"/>
                <textElement textAlignment="Center" verticalAlignment="Top">
                    <font size="8.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{stt}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Bold" x="35" y="4" width="225" height="12" forecolor="#111827" uuid="a1a1a1a1-0070-0000-0000-000000000070"/>
                <textElement verticalAlignment="Top">
                    <font size="8.5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{medicineName}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Default" x="35" y="16" width="225" height="10" forecolor="#6B7280" uuid="a1a1a1a1-0071-0000-0000-000000000071"/>
                <textElement verticalAlignment="Top">
                    <font size="7.5" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{activeIngredient} != null && !$F{activeIngredient}.isEmpty() ? "Hoạt chất: " + $F{activeIngredient} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Bold" x="265" y="4" width="60" height="20" uuid="a1a1a1a1-0072-0000-0000-000000000072"/>
                <textElement textAlignment="Center" verticalAlignment="Top">
                    <font size="8.5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity} + " " + ($F{unit} != null ? $F{unit} : "")]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Default" x="330" y="4" width="200" height="12" uuid="a1a1a1a1-0073-0000-0000-000000000073"/>
                <textElement verticalAlignment="Top">
                    <font size="8.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{instructions}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Default" x="330" y="16" width="200" height="10" forecolor="#6B7280" uuid="a1a1a1a1-0074-0000-0000-000000000074"/>
                <textElement verticalAlignment="Top">
                    <font size="7.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dosageAndRoute} != null && !$F{dosageAndRoute}.isEmpty() ? "(" + $F{dosageAndRoute} + ")" : ""]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="15" splitType="Stretch">
            <textField>
                <reportElement style="Default" x="435" y="0" width="100" height="13" forecolor="#9CA3AF" uuid="a1a1a1a1-0094-0000-0000-000000000094"/>
                <textElement textAlignment="Right">
                    <font size="7.5"/>
                </textElement>
                <textFieldExpression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Default" x="0" y="0" width="300" height="13" forecolor="#9CA3AF" uuid="a1a1a1a1-0095-0000-0000-000000000095"/>
                <textElement>
                    <font size="7.5"/>
                </textElement>
                <text><![CDATA[Hệ thống Quản lý Phòng khám Thông minh MedQueue]]></text>
            </staticText>
        </band>
    </pageFooter>

    <!-- Summary: Advice, Follow-up date, Signatures -->
    <summary>
        <band height="185" splitType="Stretch">
            <!-- No prescription note if false -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Default" x="0" y="6" width="535" height="14" forecolor="#6B7280" uuid="a1a1a1a1-0075-0000-0000-000000000075">
                    <printWhenExpression><![CDATA[!$P{hasPrescription}]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center">
                    <font size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["(Ca khám này không kê thuốc Tây / Bệnh nhân tiếp tục theo dõi điều trị lâm sàng)"]]></textFieldExpression>
            </textField>

            <!-- Prescription Advice -->
            <frame>
                <reportElement positionType="Float" x="0" y="24" width="535" height="18" uuid="a1a1a1a1-0076-0000-0000-000000000076">
                    <printWhenExpression><![CDATA[$P{hasPrescription} && $P{prescriptionAdvice} != null && !$P{prescriptionAdvice}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <staticText>
                    <reportElement style="Bold" x="0" y="0" width="135" height="14" forecolor="#1E3A8A" uuid="a1a1a1a1-0077-0000-0000-000000000077"/>
                    <text><![CDATA[Lời dặn về sử dụng thuốc:]]></text>
                </staticText>
                <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                    <reportElement style="Default" x="140" y="0" width="395" height="14" uuid="a1a1a1a1-0078-0000-0000-000000000078"/>
                    <textFieldExpression><![CDATA[$P{prescriptionAdvice}]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Revisit Follow-up Date Block -->
            <frame>
                <reportElement positionType="Float" x="0" y="44" width="535" height="24" uuid="a1a1a1a1-0079-0000-0000-000000000079">
                    <printWhenExpression><![CDATA[$P{revisitDate} != null && !$P{revisitDate}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <rectangle>
                    <reportElement x="0" y="0" width="535" height="22" backcolor="#EFF6FF" uuid="a1a1a1a1-0080-0000-0000-000000000080"/>
                    <graphicElement>
                        <pen lineWidth="0.5" lineColor="#93C5FD"/>
                    </graphicElement>
                </rectangle>
                <staticText>
                    <reportElement style="Bold" x="8" y="4" width="105" height="14" forecolor="#1D4ED8" uuid="a1a1a1a1-0081-0000-0000-000000000081"/>
                    <text><![CDATA[Hẹn ngày tái khám:]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement style="Bold" x="115" y="4" width="90" height="14" forecolor="#1D4ED8" uuid="a1a1a1a1-0082-0000-0000-000000000082"/>
                    <textFieldExpression><![CDATA[$P{revisitDate}]]></textFieldExpression>
                </textField>
                <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                    <reportElement style="Default" x="210" y="4" width="315" height="14" forecolor="#3B82F6" uuid="a1a1a1a1-0083-0000-0000-000000000083"/>
                    <textFieldExpression><![CDATA[$P{revisitNotes} != null && !$P{revisitNotes}.isEmpty() ? "(" + $P{revisitNotes} + ")" : ""]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Signatures Section -->
            <frame>
                <reportElement positionType="Float" x="0" y="76" width="535" height="90" uuid="a1a1a1a1-0084-0000-0000-000000000084"/>

                <!-- Patient Signature Column -->
                <staticText>
                    <reportElement style="Bold" x="20" y="10" width="200" height="14" uuid="a1a1a1a1-0085-0000-0000-000000000085"/>
                    <textElement textAlignment="Center"/>
                    <text><![CDATA[BỆNH NHÂN / NGƯỜI NHÀ]]></text>
                </staticText>
                <staticText>
                    <reportElement style="Default" x="20" y="24" width="200" height="12" forecolor="#6B7280" uuid="a1a1a1a1-0086-0000-0000-000000000086"/>
                    <textElement textAlignment="Center">
                        <font size="8" isItalic="true"/>
                    </textElement>
                    <text><![CDATA[(Ký và ghi rõ họ tên)]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement style="Default" x="20" y="70" width="200" height="14" uuid="a1a1a1a1-0087-0000-0000-000000000087"/>
                    <textElement textAlignment="Center">
                        <font size="8.5"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{patientName}]]></textFieldExpression>
                </textField>

                <!-- Doctor Signature Column -->
                <textField isBlankWhenNull="true">
                    <reportElement style="Default" x="310" y="0" width="220" height="12" forecolor="#4B5563" uuid="a1a1a1a1-0088-0000-0000-000000000088"/>
                    <textElement textAlignment="Center">
                        <font size="8" isItalic="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Hà Nội, " + $P{createdAt}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement style="Bold" x="310" y="14" width="220" height="14" forecolor="#111827" uuid="a1a1a1a1-0089-0000-0000-000000000089"/>
                    <textElement textAlignment="Center">
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[BÁC SĨ KHÁM BỆNH]]></text>
                </staticText>
                <staticText>
                    <reportElement style="Default" x="310" y="28" width="220" height="12" forecolor="#6B7280" uuid="a1a1a1a1-0090-0000-0000-000000000090"/>
                    <textElement textAlignment="Center">
                        <font size="8" isItalic="true"/>
                    </textElement>
                    <text><![CDATA[(Ký và ghi rõ họ tên)]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement style="Bold" x="310" y="70" width="220" height="14" forecolor="#1F2937" uuid="a1a1a1a1-0091-0000-0000-000000000091"/>
                    <textElement textAlignment="Center">
                        <font size="9.5" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{doctorName}]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Bottom Note -->
            <line>
                <reportElement positionType="Float" x="0" y="170" width="535" height="1" forecolor="#E5E7EB" uuid="a1a1a1a1-0092-0000-0000-000000000092"/>
            </line>
            <staticText>
                <reportElement style="Default" positionType="Float" x="0" y="173" width="535" height="12" forecolor="#9CA3AF" uuid="a1a1a1a1-0093-0000-0000-000000000093"/>
                <textElement textAlignment="Center">
                    <font size="7.5" isItalic="true"/>
                </textElement>
                <text><![CDATA[* Chú ý: Đơn thuốc có giá trị mua trong vòng 05 ngày kể từ ngày kê đơn. Vui lòng mang theo phiếu này khi tái khám.]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
